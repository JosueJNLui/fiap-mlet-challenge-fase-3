{
  "title": "Triagem de Laudos - Traces",
  "uid": "triagem-traces-dashboard",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Traces por segundo",
      "type": "timeseries",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "metricsQueryType": "range",
          "tableType": "traces",
          "query": "{ resource.service.name = \"triagem-api\" } | rate()",
          "legendFormat": "traces/s"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latência dos Traces (p50 / p95)",
      "type": "timeseries",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "p50",
          "queryType": "traceql",
          "metricsQueryType": "range",
          "tableType": "traces",
          "query": "{ resource.service.name = \"triagem-api\" } | quantile_over_time(duration, 0.50)",
          "legendFormat": "p50"
        },
        {
          "refId": "p95",
          "queryType": "traceql",
          "metricsQueryType": "range",
          "tableType": "traces",
          "query": "{ resource.service.name = \"triagem-api\" } | quantile_over_time(duration, 0.95)",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "title": "Taxa de Erros (status = error)",
      "type": "timeseries",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "metricsQueryType": "range",
          "tableType": "traces",
          "query": "{ resource.service.name = \"triagem-api\" && status = error } | rate()",
          "legendFormat": "erros/s"
        }
      ]
    },
    {
      "id": 4,
      "title": "Requisições por Classe de Urgência",
      "type": "timeseries",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "metricsQueryType": "range",
          "tableType": "traces",
          "query": "{ resource.service.name = \"triagem-api\" } | rate() by (classe)",
          "legendFormat": "{{classe}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Traces Recentes",
      "type": "table",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "tableType": "traces",
          "limit": 20,
          "query": "{ resource.service.name = \"triagem-api\" }"
        }
      ]
    }
  ]
}