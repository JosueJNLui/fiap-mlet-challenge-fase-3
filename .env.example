# Configurações de ambiente para o pipeline
# Copie para .env e preencha os valores

# DagsHub (obrigatório para tracking remoto e Model Registry)
# Obtenha seu token em: https://dagshub.com/user/settings/tokens
DAGSHUB_USER=seu_usuario
DAGSHUB_TOKEN=seu_token_pessoal

# Opcional: sobrescrever owner/repo se diferente do padrão
# DAGSHUB_REPO_OWNER=JosueJNLui
# DAGSHUB_REPO_NAME=fiap-mlet-challenge-fase-3

# MLflow experiment name (opcional, padrão no config.yaml)
# MLFLOW__EXPERIMENT_NAME=Medical-Abstracts-Classification

# --- Tracing da API (OpenTelemetry/Tempo) ---
# OTEL_ENABLED=false desliga traces E logs inteiramente.
#
# TRACING_LEVEL controla a verbosidade de eventos/atributos em cada nó (span)
# do node graph no Tempo/Grafana:
#   error   -> apenas exceções
#   warning -> erros + avisos (payload vazio, baixa confiança, ...)
#   info    -> tudo acima + eventos de progresso por fase de execução
# TRACING_LEVEL=info
# TRACING_LOG_PAYLOAD=false  # true inclui o abstract (truncado) como atributo do span
# TRACING_MAX_TEXT_CHARS=200 # tamanho máximo do texto em atributo de span
#
# LOG_LEVEL controla a verbosidade dos logs estruturados enviados ao Loki:
#   error   -> apenas exceções
#   warning -> erros + avisos (payload vazio, baixa confiança, ...)
#   info    -> tudo acima + logs de progresso por fase de execução
# LOG_LEVEL=info